# ── Required ────────────────────────────────────────────────────────────────
# Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Web search: set ONE of these (both have a free allowance) ───────────────
# Brave Search API: https://brave.com/search/api/
#   $5 of free credit every month (~1,000 queries); card required at signup.
BRAVE_API_KEY=
# Tavily: https://tavily.com/  (1,000 free credits/month, no card)
TAVILY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# brave | tavily. Default: whichever key above is set (Brave wins if both).
# SEARCH_PROVIDER=brave

# Answering model and the small model used for memory planning + claim extraction.
# MAIN_MODEL=claude-opus-5-5
# FAST_MODEL=claude-haiku-5-5
# Reasoning effort for answers: low | medium | high
# MAIN_EFFORT=medium

# PORT=3000
# DB_PATH=./data/agent.db

# Pretend "now" is a different instant (ISO 8601). Used by `npm run seed` and evals.
# FAKE_NOW=2026-11-03T10:00:00Z
